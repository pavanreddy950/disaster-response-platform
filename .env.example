# HTTP port
PORT=3000

# SQLite file path (use :memory: for an ephemeral database)
DATABASE_PATH=./data/app.db

# Geocoder: "mock" (offline gazetteer, default) or "nominatim" (OpenStreetMap, no API key).
# With "nominatim", the mock gazetteer is still used as a fallback when Nominatim fails.
GEOCODER=mock
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Nominatim's usage policy requires an identifying User-Agent
GEOCODER_USER_AGENT=disaster-response-assignment/1.0 (contact: you@example.com)

# Social media (community reports) API. Leave empty to use the built-in mock
# service mounted at http://localhost:$PORT/mock/social
SOCIAL_API_URL=
# Probability (0..1) that the built-in mock social service returns a 503, to exercise failure handling
SOCIAL_MOCK_FAILURE_RATE=0.2
# Artificial latency of the mock social service, in milliseconds
SOCIAL_MOCK_LATENCY_MS=300

# External call behaviour
EXTERNAL_TIMEOUT_MS=3000
EXTERNAL_RETRIES=2

# Cache TTLs (seconds)
REPORTS_CACHE_TTL_SECONDS=60
GEOCODE_CACHE_TTL_SECONDS=604800
